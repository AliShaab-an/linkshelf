{
  "name": "linkshelf",
  "description": "Park tabs, organize useful links, and return to them at the right time.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run features/operations features/reminders/reminder-background.test.ts storage",
    "test:native": "node scripts/native/run.mjs",
    "bench:performance": "node scripts/performance/run.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run compile && npm test && npm run build",
    "release": "npm run verify && npm run zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "web-ext": "^5.5.0",
    "wxt": "^0.20.27"
  }
}
